VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Meta App ID (public, safe to expose client-side -- used to init the
# Facebook JS SDK for WhatsApp Embedded Signup). The App Secret stays
# server-only as a Supabase Edge Function secret, never here.
VITE_META_APP_ID=your-meta-app-id
# Created in Meta App Dashboard > WhatsApp > Embedded Signup once the Tech
# Provider App Review is approved. Leave empty until you have it.
VITE_META_WHATSAPP_CONFIG_ID=
